{
  "compilerOptions": {
    "tsBuildInfoFile": "./vendor/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["node"],
    "typeRoots": ["./vendor/node_modules/@types", "./node_modules/@types"],
    "skipLibCheck": true,
    "allowJs": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "react": ["./node_modules/@types/react", "./vendor/node_modules/react"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime", "./vendor/node_modules/react/jsx-runtime"],
      "react/jsx-dev-runtime": ["./node_modules/@types/react/jsx-dev-runtime", "./vendor/node_modules/react/jsx-dev-runtime"],
      "react-dom": ["./node_modules/@types/react-dom", "./vendor/node_modules/react-dom"],
      "react-dom/client": ["./node_modules/@types/react-dom/client", "./vendor/node_modules/react-dom/client"],
      "*": ["./vendor/node_modules/*", "./node_modules/*"]
    }
  },
  "include": ["src"]
}
