# AyurVerse — environment variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# Supabase (Postgres + Auth + Storage + Realtime)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google OAuth (sign-in)
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_AUTH_PROXY=

# AI gateway — powers Vaidya agent + house scribe (big-pickle via OpenCode Zen)
OPENCODE_API_KEY=

# Razorpay — creator payouts & boost settlement (optional; queues locally if unset)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Firebase (new complete database — project: ayurverse)
# From Firebase Console → Project settings → Your apps → Web config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=ayurverse.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ayurverse
VITE_FIREBASE_STORAGE_BUCKET=ayurverse.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Set to 1 to run against `firebase emulators:start` instead of the cloud.
VITE_FIREBASE_USE_EMULATOR=
# Server-only Firebase credential for local API routes.
# Do NOT put private service-account JSON in committed `.env` or `vercel.json`.
# Save the downloaded JSON outside this repository, then set only its path in
# untracked `.env.local`.
GOOGLE_APPLICATION_CREDENTIALS=
# FIREBASE_SERVICE_ACCOUNT_JSON=
