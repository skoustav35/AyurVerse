// Firestore rules for LOCAL EMULATOR SEEDING ONLY — never deploy.
// The reseed script runs unauthenticated; this file opens all reads/writes
// so the emulator accepts the seed. Production keeps firestore.rules.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
